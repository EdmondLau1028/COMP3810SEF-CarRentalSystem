<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= car.brand %> <%= car.model %> | DriveEase</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root { --ink:#172237; --muted:#6a7381; --accent:#ef641c; --line:#e5e6e9; --pale:#f7f7f8; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; color:var(--ink); background:#fff; font-family:Outfit,Arial,"PingFang HK","Microsoft JhengHei",sans-serif; }
    a { color:inherit; text-decoration:none; }
    button, input { font:inherit; }
    .container { width:min(1100px,calc(100% - 44px)); margin-inline:auto; }
    .header { background:#fff; border-bottom:1px solid #e7e9ed; position:relative; z-index:5; }
    .nav { display:flex; justify-content:space-between; align-items:center; min-height:80px; gap:20px; }
    .logo { font-size:30px; font-weight:900; letter-spacing:-1.8px; white-space:nowrap; }
    .logo em { font-style:italic; color:var(--accent); }
    .nav-links { display:flex; align-items:center; gap:25px; font-size:14px; font-weight:700; }
    .nav-links a:hover,.account a:hover { color:var(--accent); }
    .account { display:flex; align-items:center; gap:16px; font-size:13px; font-weight:700; }
    .account form { margin:0; }
    .language { display:flex; padding:4px; border-radius:10px; background:#f0f2f5; }
    .language button { border:0; background:transparent; color:#697386; border-radius:7px; padding:8px 10px; font-size:12px; cursor:pointer; font-weight:800; }
    .language button.active { background:white; color:var(--accent); box-shadow:0 1px 5px #00000014; }
    .login-link { white-space:nowrap; }
    .register-link,.logout { padding:12px 16px; border:0; border-radius:10px; background:#fff0e5; color:#b64b0f; font-weight:800; cursor:pointer; }
    .register-link { background:var(--accent); color:#fff; }
    .greeting { color:#536074; }
    .hero { position:relative; background:#777c82; overflow:hidden; }
    .hero-inner { height:380px; width:min(1200px,100%); margin:0 auto; display:flex; justify-content:center; align-items:center; }
    .hero-photo { display:block; width:100%; height:100%; object-fit:contain; }
    .back { display:inline-block; color:#bb561e; font-size:13px; margin:37px 0 18px; font-weight:700; }
    .car-overview { display:grid; grid-template-columns:minmax(0,1fr) 310px; align-items:center; gap:45px; padding:15px 0 42px; }
    .category { display:block; font-size:12px; letter-spacing:.13em; color:#df652b; text-transform:uppercase; font-weight:800; margin-bottom:12px; }
    .car-overview h1 { font-size:clamp(30px,4.1vw,47px); letter-spacing:-.04em; font-weight:800; line-height:1.18; margin:0 0 14px; }
    .description { font-size:16px; line-height:1.8; color:#626c79; max-width:660px; margin:0; }
    .price-box { padding-left:34px; border-left:1px solid var(--line); }
    .price-box .label { color:var(--muted); font-size:13px; font-weight:700; }
    .price { margin:4px 0 17px; white-space:nowrap; }
    .price strong { font-size:32px; color:#24282f; font-weight:900; }
    .price small { font-size:14px; color:#7a808b; margin-left:5px; }
    .action { display:inline-block; padding:14px 22px; background:#ed7a67; color:white; font-size:14px; font-weight:800; text-align:center; border-radius:2px; }
    .action:hover { background:#df634f; }
    .specs { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:26px 0; gap:20px; }
    .spec { display:flex; align-items:center; gap:12px; min-width:0; }
    .spec-icon { font-size:24px; line-height:1; color:#a4b7c2; min-width:30px; text-align:center; }
    .spec-text { min-width:0; }
    .spec-text span { display:block; font-size:12px; color:#89919d; margin-bottom:4px; }
    .spec-text strong { display:block; font-size:15px; color:#34383e; font-weight:700; overflow-wrap:anywhere; }
    .section { padding:36px 0; border-bottom:1px solid var(--line); }
    .section h2 { font-size:20px; font-weight:800; margin:0 0 15px; }
    .section p { color:#606b79; line-height:1.85; margin:0; }
    .pickup-row { display:flex; align-items:center; gap:18px; }
    .pickup-icon { color:#8fbdcd; font-size:27px; }
    .rental { background:#fafafa; margin-top:45px; margin-bottom:70px; padding:32px 36px 30px; border:1px solid #ebebee; scroll-margin-top:24px; }
    .rental-head { display:flex; align-items:flex-start; justify-content:space-between; gap:25px; margin-bottom:23px; }
    .rental h2 { margin:0 0 6px; font-size:22px; }
    .rental-lead { margin:0; color:#7b8290; font-size:13px; }
    .rental-day { font-size:13px; color:#777f8e; }
    .rental-day b { font-size:23px; color:#262d38; margin-left:5px; }
    .date-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; }
    .field label { display:block; font-size:13px; color:#39465a; font-weight:700; margin-bottom:8px; }
    .field input { width:100%; min-height:51px; border:1px solid #d5dce4; border-radius:4px; background:#fff; padding:11px 14px; color:#293448; }
    .quote { display:flex; flex-wrap:wrap; align-items:center; gap:35px; border-top:1px solid #e5e6e8; margin-top:26px; padding-top:20px; }
    .quote-item { display:flex; flex-direction:column; gap:4px; }
    .quote-item span { color:#7e8795; font-size:13px; }
    .quote-item strong { font-weight:800; font-size:22px; }
    .book-button,.guest-cta { margin-left:auto; border:0; border-radius:3px; padding:14px 19px; font-weight:800; background:#ef641c; color:white; cursor:pointer; text-align:center; font-size:14px; }
    .book-button:hover:not(:disabled),.guest-cta:hover { background:#da5410; }
    .book-button:disabled { background:#dfe4eb; color:#647083; cursor:not-allowed; }
    .error-message { border:1px solid #fecaca; background:#fff4f3; color:#b42318; padding:13px 17px; font-size:13px; margin:17px 0 0; }
    .notice { margin:17px 0 0; font-size:12px; line-height:1.8; color:#87909c; }
    .sign-in { display:inline-block; color:#d85c35; font-size:13px; font-weight:800; margin-top:15px; }
    .footer { background:#141f2d; color:#bcc5d2; padding:25px 15px; font-size:12px; text-align:center; }
    @media (max-width:950px) { .nav-links { gap:14px; } .car-overview { grid-template-columns:1fr; gap:22px; } .price-box { padding:0; border:0; } .specs { grid-template-columns:repeat(3,minmax(0,1fr)); } }
    @media (max-width:670px) {
      .container { width:calc(100% - 32px); } .nav { min-height:70px; flex-wrap:wrap; padding:12px 0; }
      .nav-links { order:3; width:100%; justify-content:center; font-size:12px; } .account { gap:8px; } .greeting { display:none; }
      .logo { font-size:26px; } .hero-inner { height:250px; } .back { margin:23px 0 10px; }
      .car-overview { padding:12px 0 27px; } .specs { grid-template-columns:1fr 1fr; gap:18px 10px; }
      .rental { padding:25px 18px; } .rental-head { flex-direction:column; gap:12px; } .date-grid { grid-template-columns:1fr; gap:15px; }
      .quote { gap:20px; } .book-button,.guest-cta { width:100%; margin-left:0; }
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="container nav">
      <a class="logo" href="/" aria-label="DriveEase Home">Drive<em>Ease</em></a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/" data-t="home">Home</a>
        <a href="/cars" data-t="cars">Browse Cars</a>
        <a href="/cars?category=luxury" data-t="luxury">Luxury Cars</a>
      </nav>
      <div class="account">
        <div class="language" aria-label="Language">
          <button type="button" data-lang="en">EN</button><button type="button" data-lang="zh">繁中</button>
        </div>
        <% if (currentUser) { %>
          <span class="greeting"><span data-t="hello">Hi,</span> <%= currentUser %></span>
          <% if (currentUser === 'admin01' || (typeof role !== 'undefined' && role === 'admin')) { %>
            <a href="/admin" data-t="adminPanel" style="background:#172237;color:#fff;padding:10px 14px;border-radius:10px;font-weight:800;">Admin</a>
          <% } %>
          <form action="/logout" method="POST"><button class="logout" type="submit" data-t="logout">Logout</button></form>
        <% } else { %>
          <a class="login-link" href="/login" data-t="login">Login</a>
          <a class="register-link" href="/register" data-t="register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <section class="hero" aria-label="Car image">
    <div class="hero-inner">
      <img class="hero-photo" src="<%= car.image || '/images/car01.jpg' %>" alt="<%= car.brand %> <%= car.model %>" onerror="this.onerror=null;this.src='/images/car01.jpg'">
    </div>
  </section>

  <main class="container">
    <a class="back" href="/cars" data-t="backCars">← Back to Cars</a>
    <section class="car-overview">
      <div>
        <span class="category" data-category="<%= car.category %>"><%= car.category %></span>
        <h1><%= car.brand %> <%= car.model %></h1>
        <p class="description" data-description-en="<%= car.description || '' %>" data-description-zh="<%= car.descriptionZh || car.description || '' %>"><%= car.descriptionZh || car.description || '' %></p>
      </div>
      <div class="price-box">
        <span class="label" data-t="dailyRate">Daily rental</span>
        <div class="price"><strong>HK$<%= Number(car.pricePerDay || 0).toLocaleString('en-HK') %></strong><small data-t="perDay">/ day</small></div>
        <a class="action" href="#rental-panel" data-t="chooseDates">Choose rental dates →</a>
      </div>
    </section>

    <section class="specs" aria-label="Car specifications">
      <div class="spec"><span class="spec-icon" aria-hidden="true">♙</span><div class="spec-text"><span data-t="seats">Seats</span><strong><%= car.seats || '—' %></strong></div></div>
      <div class="spec"><span class="spec-icon" aria-hidden="true">⚙</span><div class="spec-text"><span data-t="transmission">Transmission</span><strong data-raw-value="<%= car.transmission || '—' %>"><%= car.transmission || '—' %></strong></div></div>
      <div class="spec"><span class="spec-icon" aria-hidden="true">♧</span><div class="spec-text"><span data-t="fuel">Fuel type</span><strong data-raw-value="<%= car.fuelType || '—' %>"><%= car.fuelType || '—' %></strong></div></div>
      <div class="spec"><span class="spec-icon" aria-hidden="true">▤</span><div class="spec-text"><span data-t="year">Model year</span><strong><%= car.year || '—' %></strong></div></div>
      <div class="spec"><span class="spec-icon" aria-hidden="true">⌖</span><div class="spec-text"><span data-t="location">Pick-up area</span><strong data-raw-value="<%= car.location || '—' %>"><%= car.location || '—' %></strong></div></div>
    </section>

    <section class="section">
      <h2 data-t="carDetails">About this car</h2>
      <p data-description-en="<%= car.description || '' %>" data-description-zh="<%= car.descriptionZh || car.description || '' %>"><%= car.descriptionZh || car.description || '' %></p>
    </section>

    <section class="section">
      <h2 data-t="pickupLocation">Pick-up location</h2>
      <div class="pickup-row"><span class="pickup-icon" aria-hidden="true">⌖</span><p data-raw-value="<%= car.location || '—' %>"><%= car.location || '—' %></p></div>
    </section>

    <section class="rental" id="rental-panel">
      <div class="rental-head">
        <div><h2 data-t="planTrip">Plan your trip</h2><p class="rental-lead" data-t="estimateOnly">Select dates to calculate an estimated rental cost.</p></div>
        <span class="rental-day"><span data-t="dailyRate">Daily rental</span> <b>HK$<%= Number(car.pricePerDay || 0).toLocaleString('en-HK') %></b></span>
      </div>
      <form action="/booking" method="POST" id="booking-form">
        <input type="hidden" name="carId" value="<%= car._id.toString() %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="date-grid">
          <div class="field"><label for="pickup" data-t="pickup">Pick-up date</label><input id="pickup" name="pickupDate" type="date" value="<%= pickupDate %>" required></div>
          <div class="field"><label for="returnDate" data-t="return">Return date</label><input id="returnDate" name="returnDate" type="date" value="<%= returnDate %>" required></div>
        </div>
        <div class="quote" aria-live="polite">
          <div class="quote-item"><span data-t="rentalDays">Rental days</span><strong id="days">—</strong></div>
          <div class="quote-item"><span data-t="estimatedTotal">Estimated total</span><strong id="total">—</strong></div>
          <% if (currentUser) { %>
            <button class="book-button" id="book-button" type="submit" data-t="confirmBooking" disabled>Confirm booking →</button>
          <% } else { %>
            <a class="guest-cta" href="/login" data-t="loginToBook">Log in to book →</a>
          <% } %>
        </div>
      </form>
      <% if (bookingError) { %><p class="error-message" id="booking-error" data-code="<%= bookingError %>" role="alert"></p><% } %>
      <p id="date-message" class="notice" role="status"></p>
      <p class="notice" data-t="quoteNotice">The system checks date availability before confirming your booking.</p>
    </section>
  </main>

  <footer class="footer">© 2026 DriveEase. All Rights Reserved.</footer>

  <script>
    const phrases = {
      en: {
        home:'Home',cars:'Browse Cars',luxury:'Luxury Cars',hello:'Hi,',adminPanel:'Admin',logout:'Logout',login:'Login',register:'Register',
        backCars:'← Back to Cars',dailyRate:'Daily rental',perDay:'/ day',chooseDates:'Choose rental dates →',
        seats:'Seats',transmission:'Transmission',fuel:'Fuel type',year:'Model year',location:'Pick-up area',
        carDetails:'About this car',pickupLocation:'Pick-up location',planTrip:'Plan your trip',
        estimateOnly:'Select dates to calculate an estimated rental cost.',pickup:'Pick-up date',return:'Return date',
        rentalDays:'Rental days',estimatedTotal:'Estimated total',confirmBooking:'Confirm booking →',
        loginToBook:'Log in to book →',quoteNotice:'The system checks date availability before confirming your booking.',
        invalidDate:'The return date must be later than the pick-up date, and the pick-up date cannot be in the past.',
        private:'Private Car',family:'Family Car',electric:'Electric Car',luxuryCategory:'Luxury Car'
      },
      zh: {
        home:'首頁',cars:'瀏覽車輛',luxury:'豪華車',hello:'你好，',adminPanel:'管理後台',logout:'登出',login:'登入',register:'註冊',
        backCars:'← 返回車輛列表',dailyRate:'日租價錢',perDay:'／天',chooseDates:'選擇租用日期 →',
        seats:'座位數',transmission:'波箱類型',fuel:'燃料類型',year:'車輛年份',location:'取車地區',
        carDetails:'車輛介紹',pickupLocation:'取車地點',planTrip:'規劃你的行程',
        estimateOnly:'選擇日期，計算預計租金。',pickup:'取車日期',return:'還車日期',
        rentalDays:'租用日數',estimatedTotal:'預計總費用',confirmBooking:'確認預訂 →',
        loginToBook:'登入後預訂 →',quoteNotice:'系統會先檢查所選日期是否有車，成功後才會確認預訂。',
        invalidDate:'還車日期必須遲於取車日期，取車日期亦不能早於今天。',
        private:'私家車',family:'家庭車',electric:'電動車',luxuryCategory:'豪華車'
      }
    };
    const categoryNames = { private:'private',family:'family',electric:'electric',luxury:'luxuryCategory' };
    const vehicleValues = {
      en:{},
      zh:{Automatic:'自動波',Manual:'手動波',Petrol:'汽油',Diesel:'柴油',Hybrid:'混能',Electric:'電動','Hong Kong Island':'香港島',Kowloon:'九龍','New Territories':'新界'}
    };
    const bookingErrors = {
      en:{dates:'Please choose valid dates (up to 365 days).',overlap:'This car is already booked for some of your selected dates. Please choose other dates.',unavailable:'This car is currently unavailable.',server:'Booking could not be completed. Please try again.'},
      zh:{dates:'請選擇有效的取車和還車日期（最多 365 天）。',overlap:'這輛車在所選日期已有其他預訂，請更改日期。',unavailable:'這輛車暫時未能預訂。',server:'預訂暫時未能完成，請稍後再試。'}
    };
    let language = 'zh';
    function setLanguage(lang) {
      language = lang;
      localStorage.setItem('driveease_language',lang);
      document.documentElement.lang = lang === 'zh' ? 'zh-Hant' : 'en';
      document.querySelectorAll('[data-lang]').forEach(button => button.classList.toggle('active',button.dataset.lang===lang));
      document.querySelectorAll('[data-t]').forEach(el => { el.textContent = phrases[lang][el.dataset.t] || el.textContent; });
      document.querySelectorAll('[data-category]').forEach(el => {
        const key = categoryNames[el.dataset.category];
        el.textContent = phrases[lang][key] || el.dataset.category;
      });
      document.querySelectorAll('[data-description-en]').forEach(el => {
        el.textContent = lang === 'zh' ? el.dataset.descriptionZh : el.dataset.descriptionEn;
      });
      document.querySelectorAll('[data-raw-value]').forEach(el => {
        const value = el.dataset.rawValue;
        el.textContent = vehicleValues[lang][value] || value;
      });
      const errorPanel = document.getElementById('booking-error');
      if (errorPanel) errorPanel.textContent = bookingErrors[lang][errorPanel.dataset.code] || bookingErrors[lang].server;
      calculate();
    }
    const pickup = document.getElementById('pickup');
    const dropoff = document.getElementById('returnDate');
    const daysNode = document.getElementById('days');
    const totalNode = document.getElementById('total');
    const dateMessage = document.getElementById('date-message');
    const bookButton = document.getElementById('book-button');
    const dailyRate = <%- JSON.stringify(Number(car.pricePerDay) || 0) %>;
    const now = new Date();
    const today = new Date(now.getTime() - now.getTimezoneOffset()*60000).toISOString().slice(0,10);
    pickup.min = today;
    dropoff.min = today;
    function calculate() {
      dropoff.min = pickup.value || today;
      daysNode.textContent = '—';
      totalNode.textContent = '—';
      dateMessage.textContent = '';
      if (bookButton) bookButton.disabled = true;
      if (!pickup.value || !dropoff.value) return;
      const from = Date.parse(pickup.value+'T00:00:00Z');
      const to = Date.parse(dropoff.value+'T00:00:00Z');
      if (!Number.isFinite(from) || !Number.isFinite(to) || to <= from || pickup.value < today || (to-from)/86400000 > 365) {
        dateMessage.textContent = phrases[language].invalidDate;
        dateMessage.style.color = '#b45309';
        return;
      }
      const days = (to - from) / 86400000;
      daysNode.textContent = String(days);
      totalNode.textContent = 'HK$' + (days*dailyRate).toLocaleString('en-HK');
      if (bookButton) bookButton.disabled = false;
    }
    pickup.addEventListener('change',calculate);
    dropoff.addEventListener('change',calculate);
    document.querySelectorAll('[data-lang]').forEach(button => button.addEventListener('click',() => setLanguage(button.dataset.lang)));
    setLanguage(localStorage.getItem('driveease_language') === 'en' ? 'en' : 'zh');
  </script>
</body>
</html>
