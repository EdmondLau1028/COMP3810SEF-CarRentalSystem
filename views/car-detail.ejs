<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= car.brand %> <%= car.name %> | DriveEase</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="navbar">
        <a class="brand" href="/">DriveEase</a>
        <nav aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/cars">Browse cars</a>
            <% if (user) { %>
                <a href="/my-booking">My bookings</a>
                <a href="/manage-cars">Manage cars</a>
                <span class="nav-greeting">Hi, <%= user.name %></span>
                <form class="nav-form" action="/logout" method="post"><button class="nav-button" type="submit">Log out</button></form>
            <% } else { %>
                <a href="/login">Log in</a>
                <a class="button button-small" href="/register">Create account</a>
            <% } %>
        </nav>
    </header>
    <main class="section page-content">
        <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
        <p class="breadcrumbs"><a href="/cars">Cars</a> <span aria-hidden="true">/</span> <%= car.name %></p>
        <% if (typeof error !== 'undefined' && error) { %><p class="alert" role="alert"><%= error %></p><% } %>
        <div class="detail-layout">
            <section class="detail-main">
                <img class="detail-image" src="<%= car.image || '/images/car.jpg' %>" alt="<%= car.brand %> <%= car.name %>">
                <p class="eyebrow"><%= car.category %></p>
                <h1><%= car.brand %> <%= car.name %></h1>
                <p class="detail-description"><%= car.description %></p>
                <div class="spec-grid">
                    <div><span>Seats</span><strong><%= car.seats %></strong></div>
                    <div><span>Transmission</span><strong><%= car.transmission %></strong></div>
                    <div><span>Fuel</span><strong><%= car.fuel %></strong></div>
                    <div><span>Category</span><strong><%= car.category %></strong></div>
                </div>
            </section>
            <aside class="booking-panel">
                <p class="price">HK$<%= car.pricePerDay %><span> / day</span></p>
                <h2>Book this car</h2>
                <% if (user) { %>
                    <form action="/cars/<%= car._id %>/bookings" method="post" class="form-stack">
                        <label for="startDate">Pick-up date</label>
                        <input id="startDate" name="startDate" type="date" min="<%= new Date().toISOString().slice(0, 10) %>" value="<%= typeof form !== 'undefined' && form.startDate ? form.startDate : '' %>" required>
                        <label for="endDate">Return date</label>
                        <input id="endDate" name="endDate" type="date" min="<%= new Date().toISOString().slice(0, 10) %>" value="<%= typeof form !== 'undefined' && form.endDate ? form.endDate : '' %>" required>
                        <p class="form-hint">Choose 1 to 30 days. Your final price is calculated from the selected dates.</p>
                        <button class="button button-full" type="submit">Confirm booking</button>
                    </form>
                <% } else { %>
                    <p class="muted">Log in or create an account to reserve this car.</p>
                    <a class="button button-full" href="/login">Log in to book</a>
                    <p class="form-hint">New to DriveEase? <a class="text-link" href="/register">Create an account</a>.</p>
                <% } %>
            </aside>
        </div>
    </main>
    <footer class="footer"><p>DriveEase <span aria-hidden="true">·</span> A smoother way to get there.</p></footer>
</body>
</html>
