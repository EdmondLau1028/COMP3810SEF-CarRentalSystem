<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create account | DriveEase</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="navbar">
        <a class="brand" href="/">DriveEase</a>
        <nav aria-label="Main navigation"><a href="/">Home</a><a href="/cars">Browse cars</a><a href="/login">Log in</a></nav>
    </header>
    <main class="auth-wrap">
        <section class="auth-card">
            <p class="eyebrow">GET STARTED</p>
            <h1>Create your account</h1>
            <p class="muted">Sign up to book a car and keep track of your trips.</p>
            <% if (typeof error !== 'undefined' && error) { %><p class="alert" role="alert"><%= error %></p><% } %>
            <form action="/register" method="post" class="form-stack">
                <label for="name">Full name</label>
                <input id="name" name="name" type="text" autocomplete="name" maxlength="100" value="<%= form && form.name ? form.name : '' %>" required>
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" maxlength="254" value="<%= form && form.email ? form.email : '' %>" required>
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" aria-describedby="password-hint" required>
                <p id="password-hint" class="form-hint">Use at least 8 characters.</p>
                <button class="button button-full" type="submit">Create account</button>
            </form>
            <p class="auth-switch">Already registered? <a class="text-link" href="/login">Log in</a></p>
        </section>
    </main>
    <footer class="footer"><p>DriveEase <span aria-hidden="true">·</span> A smoother way to get there.</p></footer>
</body>
</html>
