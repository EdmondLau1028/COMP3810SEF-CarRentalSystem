<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage cars | DriveEase</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="navbar">
        <a class="brand" href="/">DriveEase</a>
        <nav aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/cars">Browse cars</a>
            <a href="/my-booking">My bookings</a>
            <a href="/manage-cars" aria-current="page">Manage cars</a>
            <span class="nav-greeting">Hi, <%= user.name %></span>
            <form class="nav-form" action="/logout" method="post"><button class="nav-button" type="submit">Log out</button></form>
        </nav>
    </header>
    <main class="section page-content">
        <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
        <div class="section-heading">
            <div>
                <p class="eyebrow">INVENTORY</p>
                <h1>Manage cars</h1>
                <p class="muted">Add, search, update, or remove cars in the fleet.</p>
            </div>
            <a class="button button-small" href="/manage-cars/new">Add a car</a>
        </div>
        <form class="car-filter" action="/manage-cars" method="get">
            <div>
                <label for="search">Name or brand</label>
                <input id="search" name="search" type="search" value="<%= filters.search %>" maxlength="80">
            </div>
            <div>
                <label for="category">Category</label>
                <input id="category" name="category" type="search" value="<%= filters.category %>" maxlength="40">
            </div>
            <div>
                <label for="available">Availability</label>
                <select id="available" name="available">
                    <option value="" <%= filters.available === '' ? 'selected' : '' %>>All</option>
                    <option value="true" <%= filters.available === 'true' ? 'selected' : '' %>>Available</option>
                    <option value="false" <%= filters.available === 'false' ? 'selected' : '' %>>Unavailable</option>
                </select>
            </div>
            <button class="button button-small" type="submit">Search</button>
            <a class="text-link" href="/manage-cars">Clear</a>
        </form>
        <% if (cars.length) { %>
            <div class="table-wrap">
                <table class="car-table">
                    <thead>
                        <tr>
                            <th scope="col">Car</th>
                            <th scope="col">Category</th>
                            <th scope="col">Seats</th>
                            <th scope="col">Daily price</th>
                            <th scope="col">Availability</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cars.forEach((car) => { %>
                            <tr>
                                <td>
                                    <strong><%= car.brand %> <%= car.name %></strong><br>
                                    <small>ID: <%= car.carId || car._id %></small>
                                </td>
                                <td><%= car.category %></td>
                                <td><%= car.seats %></td>
                                <td>HK$<%= car.pricePerDay %></td>
                                <td><%= car.available === false ? 'Unavailable' : 'Available' %></td>
                                <td>
                                    <div class="table-actions">
                                        <a class="text-link" href="/manage-cars/<%= car._id %>/edit">Edit</a>
                                        <form action="/manage-cars/<%= car._id %>/delete" method="post">
                                            <button class="text-button" type="submit">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <h2>No matching cars</h2>
                <p>Add a car or change your search filters.</p>
            </div>
        <% } %>
    </main>
    <footer class="footer"><p>DriveEase <span aria-hidden="true">·</span> A smoother way to get there.</p></footer>
</body>
</html>
