        /* ===============================
           Language Switch
        =============================== */

        let language =
            localStorage.getItem("rentdrive_language") === "zh"
                ? "zh"
                : "en";

        const text = key =>
            messages[language][key] || key;

        const searchMessage =
            document.getElementById("ec-search-note");


        function setLanguage(lang) {

            language = lang === "zh" ? "zh" : "en";

            localStorage.setItem(
                "rentdrive_language",
                language
            );

            document.documentElement.lang =
                language === "zh" ? "zh-Hant" : "en";

            document.title =
                language === "zh"
                    ? "RentDrive｜香港租車預訂"
                    : "RentDrive | Rent Your Next Car";


            // Translate all elements
            document.querySelectorAll("[data-t]").forEach(el => {

                el.textContent =
                    text(el.dataset.t);

            });


            // Translate input placeholders
            document.querySelectorAll("[data-placeholder]").forEach(el => {

                el.placeholder =
                    text(el.dataset.placeholder);

            });


            // Update language buttons
            document.querySelectorAll("[data-language]").forEach(btn => {

                btn.classList.toggle(
                    "active",
                    btn.dataset.language === language
                );

            });


            if (searchMessage.dataset.message) {

                searchMessage.textContent =
                    text(searchMessage.dataset.message);

            }

        }


        document.querySelectorAll("[data-language]").forEach(btn => {

            btn.addEventListener("click", () => {

                setLanguage(btn.dataset.language);

            });

        });

        setLanguage(language);


        /* ===============================
           Popular Cars Carousel
        =============================== */
        const showcaseTrack = document.getElementById("ec-showcase-track");
        const slidePrev = document.getElementById("ec-slide-prev");
        const slideNext = document.getElementById("ec-slide-next");
        if (showcaseTrack && slidePrev && slideNext) {
            const slide = direction => showcaseTrack.scrollBy({
                left: direction * Math.max(320, showcaseTrack.clientWidth * .8),
                behavior: "smooth"
            });
            slidePrev.addEventListener("click", () => slide(-1));
            slideNext.addEventListener("click", () => slide(1));
        }

        /* ===============================
           Date Validation
        =============================== */

        const start =
            document.getElementById("ec-from");

        const end =
            document.getElementById("ec-to");

        const now = new Date();

        const today = new Date(
            now.getTime() -
            now.getTimezoneOffset() * 60000
        ).toISOString().slice(0, 10);

        start.min = today;
        end.min = today;


        start.addEventListener("change", () => {

            end.min = start.value || today;

        });


        /* ===============================
           Search Form
        =============================== */

        document.getElementById("ec-search-form")
            .addEventListener("submit", event => {

                event.preventDefault();

                if (end.value <= start.value) {

                    searchMessage.dataset.message =
                        "badDate";

                    searchMessage.style.color =
                        "#c2410c";

                    searchMessage.textContent =
                        text("badDate");

                    return;
                }


                const locations = {
                    hk: "Hong Kong Island",
                    kowloon: "Kowloon",
                    nt: "New Territories"
                };
                const params = new URLSearchParams();
                params.set("category", document.getElementById("ec-type").value);
                params.set("location", locations[document.getElementById("ec-pickup").value] || "");
                params.set("pickupDate", start.value);
                params.set("returnDate", end.value);

                // Search the MongoDB-backed listing. Date availability is checked
                // later, when booking functionality is implemented.
                window.location.href = "/cars?" + params.toString();

            });

    </script>

