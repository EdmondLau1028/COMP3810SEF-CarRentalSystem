/* =========================================
    RENTAL PROCESS - BACKGROUND & TIMELINE
========================================= */

.ec-process {

    position: relative;

    padding: 95px 0 105px;

    color: white;

    background-image:
        linear-gradient(
            rgba(10, 20, 32, 0.75),
            rgba(10, 20, 32, 0.75)
        ),
        url("/images/car02.jpg");

    background-position: center center;

    background-size: cover;

    background-repeat: no-repeat;

    background-attachment: scroll;
}


/* =========================================
   SECTION TITLE
========================================= */

.ec-process .ec-heading {

    display: block;

    text-align: center;

    margin-bottom: 65px;
}

.ec-process .ec-heading h2 {

    color: white;

    font-size: 38px;

    font-weight: 800;

    margin-bottom: 12px;
}

.ec-process .ec-heading p {

    color: rgba(255, 255, 255, 0.85);

    font-size: 16px;
}


/* =========================================
   HORIZONTAL TIMELINE
========================================= */

.ec-process .ec-process-grid {

    position: relative;

    display: grid;

    grid-template-columns: repeat(5, minmax(0, 1fr));

    gap: 15px;

    min-height: 410px;
}


/* Main White Line */

.ec-process .ec-process-grid::before {

    content: "";

    position: absolute;

    top: 188px;

    left: 10%;

    right: 10%;

    height: 2px;

    background: rgba(255, 255, 255, 0.8);
}


/* =========================================
   EACH STEP
========================================= */

.ec-process .ec-step {

    position: relative;

    min-height: 410px;

    background: transparent;

    border: none;

    border-radius: 0;

    padding: 0 10px;

    text-align: center;

    color: white;
}


/* Step Content */

.ec-process .ec-step-content {

    position: absolute;

    left: 0;

    right: 0;

    padding: 0 8px;
}


/* Odd Steps - Above Timeline */

.ec-process .ec-step-top .ec-step-content {

    top: 0;
}


/* Even Steps - Below Timeline */

.ec-process .ec-step-bottom .ec-step-content {

    top: 230px;
}


/* =========================================
   ICONS
========================================= */

.ec-process .ec-step svg {

    width: 65px;

    height: 65px;

    display: block;

    margin: 0 auto 16px;

    color: white;

    transition: transform 0.3s ease;
}


/* Hover Effect */

.ec-process .ec-step:hover svg {

    transform: translateY(-6px);
}


/* =========================================
   TEXT
========================================= */

.ec-process .ec-step h3 {

    color: white;

    font-size: 17px;

    font-weight: 700;

    margin: 0 0 10px;
}


/* Step Number */

.ec-process .ec-step h3 > span:first-child {

    color: #ff9d59;

    font-weight: 900;

    margin-right: 5px;
}


/* Description */

.ec-process .ec-step p {

    color: rgba(255, 255, 255, 0.88);

    font-size: 13px;

    line-height: 1.6;

    margin: 0;
}


/* =========================================
   TIMELINE DOTS
========================================= */

.ec-process .ec-step-dot {

    position: absolute;

    top: 180px;

    left: 50%;

    transform: translateX(-50%);

    width: 18px;

    height: 18px;

    background: white;

    border: 4px solid white;

    border-radius: 50%;

    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.18);

    z-index: 2;
}


/* Vertical Connector */

.ec-process .ec-step-top::before,
.ec-process .ec-step-bottom::before {

    content: "";

    position: absolute;

    left: 50%;

    width: 1px;

    background: rgba(255, 255, 255, 0.65);
}


/* Connector for top steps */

.ec-process .ec-step-top::before {

    top: 164px;

    height: 16px;
}


/* Connector for bottom steps */

.ec-process .ec-step-bottom::before {

    top: 198px;

    height: 25px;
}


/* =========================================
   TABLET & MOBILE
========================================= */

@media (max-width: 900px) {

    .ec-process {

        padding: 75px 0;

        background-position: center;
    }

    .ec-process .ec-process-grid {

        display: grid;

        grid-template-columns: 1fr;

        gap: 20px;

        min-height: auto;
    }


    /* Vertical Timeline */

    .ec-process .ec-process-grid::before {

        left: 24px;

        right: auto;

        top: 20px;

        bottom: 20px;

        width: 2px;

        height: auto;
    }


    .ec-process .ec-step {

        min-height: auto;

        padding: 10px 0 25px 70px;

        text-align: left;
    }


    .ec-process .ec-step-content {

        position: static;

        text-align: left;

        padding: 0;
    }


    .ec-process .ec-step svg {

        width: 50px;

        height: 50px;

        margin: 0 0 15px;
    }


    .ec-process .ec-step-dot {

        top: 25px;

        left: 25px;
    }


    .ec-process .ec-step-top::before,
    .ec-process .ec-step-bottom::before {

        display: none;
    }


    .ec-process .ec-heading h2 {

        font-size: 30px;
    }

}
