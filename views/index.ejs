<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Find and book a car for your next journey with DriveEase.">
    <title>DriveEase | Car rental made easy</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="navbar">
        <a class="brand" href="/">DriveEase</a>
        <nav aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/cars">Browse cars</a>
            <% if (user) { %>
                <a href="/my-booking">My bookings</a>
                <a href="/manage-cars">Manage cars</a>
                <span class="nav-greeting">Hi, <%= user.name %></span>
                <form class="nav-form" action="/logout" method="post">
                    <button class="nav-button" type="submit">Log out</button>
                </form>
            <% } else { %>
                <a href="/login">Log in</a>
                <a class="button button-small" href="/register">Create account</a>
            <% } %>
        </nav>
    </header>

    <main>
        <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">YOUR NEXT JOURNEY STARTS HERE</p>
                <h1>Find your perfect rental car</h1>
                <p>Discover comfortable, reliable cars for commutes, weekends, and everything in between.</p>
                <a class="button" href="/cars">Explore available cars</a>
            </div>
            <div class="hero-image" role="img" aria-label="A car ready for your next journey"></div>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">READY WHEN YOU ARE</p>
                    <h2>Featured cars</h2>
                </div>
                <a class="text-link" href="/cars">View all cars <span aria-hidden="true">→</span></a>
            </div>
            <% if (cars.length) { %>
                <div class="car-grid">
                    <% cars.forEach((car) => { %>
                        <article class="car-card">
                            <a class="car-image-link" href="/cars/<%= car._id %>" aria-label="View <%= car.name %>">
                                <img src="<%= car.image || '/images/car.jpg' %>" alt="<%= car.brand %> <%= car.name %>">
                            </a>
                            <div class="car-card-body">
                                <p class="car-category"><%= car.category %></p>
                                <h3><a href="/cars/<%= car._id %>"><%= car.brand %> <%= car.name %></a></h3>
                                <p class="car-specs"><%= car.seats %> seats <span aria-hidden="true">·</span> <%= car.transmission %></p>
                                <div class="car-card-footer">
                                    <p class="price">HK$<%= car.pricePerDay %><span> / day</span></p>
                                    <a class="text-link" href="/cars/<%= car._id %>">Details</a>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <h3>Cars are on the way</h3>
                    <p>There are no cars available right now. Please check back soon.</p>
                </div>
            <% } %>
        </section>
    </main>
    <footer class="footer"><p>DriveEase <span aria-hidden="true">·</span> A smoother way to get there.</p></footer>
</body>
</html>
