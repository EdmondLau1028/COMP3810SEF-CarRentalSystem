        -webkit-text-fill-color: transparent;

        font-style: italic;

        position: relative;
    }

    /* Orange underline */
    .ec-logo-accent::after {
        content: "";

        position: absolute;

        left: 5%;
        bottom: -4px;

        width: 85%;
        height: 3px;

        background: #f97316;

        border-radius: 10px;
    }

    /* Hover animation */
    .ec-header .ec-brand {
    display: inline-flex;
    align-items: baseline;

    gap: 0;

    font-family: "Outfit", "Avenir Next", sans-serif;

    font-size: 34px;
    font-weight: 900;

    letter-spacing: -1.8px;

    text-decoration: none;

    white-space: nowrap;
}


/* Rent - Dark Navy */
.ec-header .ec-logo-primary {
    color: #142235;
}


    /* Drive - Orange Italic */
    .ec-header .ec-logo-accent {
        color: #f97316;

        font-style: italic;

        background: none;

        -webkit-text-fill-color: #f97316;
    }


    /* Remove previous underline decoration */
    .ec-header .ec-logo-accent::after {
        display: none;
    }


    /* Mobile */
    @media (max-width: 768px) {

        .ec-header .ec-brand {
            font-size: 29px;
        }

    }

    /* Minimal horizontal featured-cars slider */
    .ec-showcase { background: #f5f4f8; padding: 74px 0 70px; }
    .ec-showcase h2 { margin: 0 0 37px; text-align:center; font-size:clamp(27px,3vw,35px); font-weight:800; letter-spacing:-.02em; }
    .ec-showcase-wrap { position:relative; }
    .ec-showcase-track { display:flex; gap:42px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:0 2px 23px; scroll-behavior:smooth; }
    .ec-showcase-track::-webkit-scrollbar { display:none; }
    .ec-showcase-item { flex:0 0 clamp(230px,23vw,320px); min-width:0; scroll-snap-align:start; color:#2b2b2b; display:flex; flex-direction:column; }
    .ec-showcase-item img { width:100%; height:210px; display:block; object-fit:cover; background:#e5e8ef; }
    .ec-showcase-name { display:block; margin:13px 0 10px; font-size:16px; line-height:1.4; min-height:45px; color:#383838; }
    .ec-showcase-price { font-size:24px; font-weight:900; color:#222; }
    .ec-showcase-price small { font-size:14px; font-weight:600; }
    .ec-slide-arrow { position:absolute; top:82px; z-index:2; width:43px; height:54px; border:0; background:rgba(20,34,53,.78); color:white; font-size:25px; cursor:pointer; }
    .ec-slide-prev { left:-17px; }.ec-slide-next { right:-17px; }
    .ec-slide-arrow:hover { background:#f97316; }
    .ec-showcase-view-all { width:min(430px,100%); min-height:53px; margin:31px auto 0; display:flex; align-items:center; justify-content:center; border:1px solid #1b2d42; background:transparent; color:#142235; font-size:16px; font-weight:700; }
    .ec-showcase-view-all:hover { background:#142235; color:white; }
    @media(max-width:680px) { .ec-showcase { padding:55px 0; }.ec-showcase-track { gap:18px; }.ec-showcase-item { flex-basis:78%; }.ec-showcase-item img { height:200px; }.ec-slide-arrow { top:78px; } }

    /* Luxury collection: two featured cars from MongoDB */
    .ec-luxury-section {
        background: #101b2b;
        color: #ffffff;
        padding: 78px 0;
    }
    .ec-luxury-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 24px;
        margin-bottom: 26px;
    }
    .ec-luxury-heading h2 { font-size: clamp(28px, 3.5vw, 42px); margin: 8px 0 10px; }
    .ec-luxury-heading p { color: #bcc7d7; margin: 0; }
    .ec-luxury-heading .ec-luxury-all { color: #ffab73; font-weight: 700; white-space: nowrap; }
    .ec-luxury-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 22px; }
    .ec-luxury-card { display: block; min-height: 360px; position: relative; border-radius: 18px; overflow: hidden; background: #283750; color: white; }
    .ec-luxury-card img { width: 100%; height: 360px; object-fit: cover; display: block; transition: transform .35s; }
    .ec-luxury-card:hover img { transform: scale(1.05); }
    .ec-luxury-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,16,29,.91), rgba(8,16,29,.01) 72%); display: flex; flex-direction: column; justify-content: end; padding: 27px; }
    .ec-luxury-tag { color: #ffc39d; font-weight: 800; letter-spacing: .09em; font-size: 11px; text-transform: uppercase; }
    .ec-luxury-overlay h3 { font-size: 28px; margin: 9px 0; }
    .ec-luxury-price { color: #ffffff; font-weight: 700; }
    @media (max-width: 720px) {
        .ec-luxury-grid { grid-template-columns: 1fr; }
        .ec-luxury-heading { display: block; }
        .ec-luxury-heading .ec-luxury-all { display: inline-block; margin-top: 15px; }
    }
    </style>

</head>

<body>

    <!-- ===============================
         Top Bar
    =============================== -->

    <div class="ec-topline">

        <div class="ec-container">

            <span data-t="topline">
                Your local car rental marketplace
            </span>

            <span data-t="topright">
                Daily · Weekly · Monthly
            </span>

        </div>

    </div>


    <!-- ===============================
         Navigation Bar
    =============================== -->

    <header class="ec-header">

        <div class="ec-container ec-nav">

            <!-- RentDrive Logo -->
            <a class="ec-brand" href="/" aria-label="RentDrive Home">

                <span class="ec-logo-primary">Rent</span><span class="ec-logo-accent">Drive</span>
            </a>

            <nav class="ec-menu">

                <a href="/" data-t="home">
                    Home
                </a>

                <a
                    href="/cars?category=private"
                    data-t="private"
                >
                    Private Cars
                </a>

                <a
                    href="/cars?category=family"
                    data-t="family"
                >
                    Family Cars
                </a>

                <a
                    href="/cars?category=electric"
                    data-t="electric"
                >
                    Electric Cars
                </a>

                <a
                    href="/cars?category=luxury"
                    data-t="luxury"
                >
                    Luxury Cars
                </a>

                <a href="#steps" data-t="rentalGuide">
                    How It Works
                </a>

            </nav>


            <!-- Account & Language -->

            <div class="ec-account">

                <div class="ec-lang">

                    <button
                        type="button"
                        data-language="en"
                        class="active"
                    >
                        EN
                    </button>

                    <button
                        type="button"
                        data-language="zh"
                    >
                        繁中
                    </button>

                </div>


                <% if (signedIn) { %>

                    <!-- Logged-in User -->

                    <span class="ec-greeting">
                        <span data-t="hello">Hi,</span>
                        <%= currentUser %>
                    </span>

                    <a
                        href="/my-booking"
                        data-t="myBookings"
                    >
                        My Bookings
                    </a>

                    <% if (currentUser === 'admin01' || (typeof role !== 'undefined' && role === 'admin')) { %>
                        <a
                            href="/admin"
                            data-t="adminPanel"
                            style="background:#142235;color:#fff;padding:10px 15px;border-radius:10px;font-weight:700;"
                        >
                            Admin
                        </a>
                    <% } %>

                    <form
                        action="/logout"
                        method="POST"
                    >

                        <button
                            class="ec-logout"
                            type="submit"
                            data-t="logout"
                        >
                            Logout
                        </button>

                    </form>

                <% } else { %>

                    <!-- Guest User -->

                    <a href="/login" data-t="login">
                        Login
                    </a>

                    <a
                        class="ec-primary"
                        href="/register"
                        data-t="register"
                    >
                        Register
                    </a>

                <% } %>

            </div>

        </div>

    </header>


    <!-- ===============================
         Hero Section
    =============================== -->

    <main>

        <section class="ec-hero">

            <div class="ec-container">

                <div class="ec-hero-content">

                    <div class="ec-kicker">

                        ✦

                        <span data-t="heroKicker">
                            EXPLORE HONG KONG YOUR WAY
                        </span>

                    </div>

                    <h1 data-t="heroTitle">
                        Your car. Your journey. Made easy.
                    </h1>

                    <p data-t="heroText">
                        Explore cars for everyday drives,
                        family weekends and unforgettable trips.
                        Find the right rental without the hassle.
                    </p>

                    <div class="ec-hero-actions">

                        <a
                            class="ec-primary"
                            href="#search-panel"
                            data-t="findCar"
                        >
                            Find a Car →
                        </a>

                        <a
                            class="ec-outline"
                            href="#fleet"
                            data-t="browseFleet"
                        >
                            Browse Popular Cars
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- ===============================
             Search Section
        =============================== -->

        <section class="ec-search-area" id="search-panel">

            <div class="ec-container">

                <div class="ec-search-card">

                    <div class="ec-search-head">

                        <h2 data-t="searchTitle">
                            Find your rental car
                        </h2>

                        <small data-t="searchSubtitle">
                            Choose your trip details
                        </small>

                    </div>


                    <form id="ec-search-form">

                        <div class="ec-search-grid">

                            <!-- Car Type -->

                            <div class="ec-field">

                                <label for="ec-type" data-t="carType">
                                    Car Type
                                </label>

                                <select id="ec-type" name="type">

                                    <option value="all" data-t="allTypes">
                                        All Types
                                    </option>

                                    <option value="private" data-t="private">
                                        Private Cars
                                    </option>

                                    <option value="family" data-t="family">
                                        Family Cars
                                    </option>

                                    <option value="electric" data-t="electric">
                                        Electric Cars
                                    </option>

                                    <option value="luxury" data-t="luxury">
                                        Luxury Cars
                                    </option>

                                </select>

                            </div>


                            <!-- Pick-up Location -->

                            <div class="ec-field">

                                <label for="ec-pickup" data-t="pickup">
                                    Pick-up Area
                                </label>

                                <select
                                    id="ec-pickup"
                                    name="location"
                                >

                                    <option value="" data-t="selectArea">
                                        All Areas
                                    </option>

                                    <option value="hk" data-t="hkIsland">
                                        Hong Kong Island
                                    </option>

                                    <option value="kowloon" data-t="kowloon">
                                        Kowloon
                                    </option>

                                    <option value="nt" data-t="nt">
                                        New Territories
                                    </option>

                                </select>

                            </div>


                            <!-- Pick-up Date -->

                            <div class="ec-field">

                                <label for="ec-from" data-t="from">
                                    Pick-up Date
                                </label>

                                <input
                                    id="ec-from"
                                    name="pickupDate"
                                    type="date"
                                    required
                                >

                            </div>


                            <!-- Return Date -->

                            <div class="ec-field">

                                <label for="ec-to" data-t="to">
                                    Return Date
                                </label>

                                <input
                                    id="ec-to"
                                    name="returnDate"
                                    type="date"
                                    required
                                >

                            </div>


                            <!-- Search Button -->

                            <button
                                class="ec-primary ec-search-submit"
                                type="submit"
                                data-t="search"
                            >
                                Search Cars →
                            </button>

                        </div>

                        <p
                            id="ec-search-note"
                            class="ec-search-note"
                            aria-live="polite"
                        ></p>

                    </form>

                </div>

            </div>

        </section>


        <!-- Clean horizontal carousel inspired by the reference layout -->
        <section class="ec-showcase" id="fleet">
            <div class="ec-container">
                <h2 data-t="popularTitle">Popular Rental Cars</h2>
                <div class="ec-showcase-wrap">
                    <button class="ec-slide-arrow ec-slide-prev" type="button" aria-label="Previous cars" id="ec-slide-prev">❮</button>
                    <div class="ec-showcase-track" id="ec-showcase-track">
                        <% visibleCars.forEach(car => { %>
                            <a class="ec-showcase-item" href="/cars/<%= car._id.toString() %>">
                                <img src="<%= car.image || '/images/car01.jpg' %>" alt="<%= car.brand %> <%= car.model %>" loading="lazy" onerror="this.onerror=null;this.src='/images/car01.jpg'">
                                <span class="ec-showcase-name"><%= car.brand %> <%= car.model %></span>
                                <span class="ec-showcase-price">HK$<%= Number(car.pricePerDay || 0).toLocaleString('en-HK') %> <small data-t="perDay">/ day</small></span>
                            </a>
                        <% }) %>
                    </div>
                    <button class="ec-slide-arrow ec-slide-next" type="button" aria-label="Next cars" id="ec-slide-next">❯</button>
                </div>
                <a class="ec-showcase-view-all" href="/cars" data-t="viewAllCars">View All Cars →</a>
            </div>
        </section>


        <!-- Luxury Collection -->
        <% if (homeLuxuryCars.length > 0) { %>
        <section class="ec-luxury-section" id="luxury">
            <div class="ec-container">
                <div class="ec-luxury-heading">
                    <div>
                        <div class="ec-luxury-tag" data-t="luxuryKicker">THE LUXURY COLLECTION</div>
                        <h2 data-t="luxuryTitle">An extraordinary drive awaits.</h2>
                        <p data-t="luxuryText">Discover our premium rental selection.</p>
                    </div>
                    <a class="ec-luxury-all" href="/cars?category=luxury" data-t="viewLuxury">Explore Luxury Cars →</a>
                </div>
                <div class="ec-luxury-grid">
                    <% homeLuxuryCars.forEach(car => { %>
                    <a class="ec-luxury-card" href="/cars/<%= car._id.toString() %>">
                        <img src="<%= car.image %>" alt="<%= car.brand %> <%= car.model %>" loading="lazy">
                        <div class="ec-luxury-overlay">
                            <span class="ec-luxury-tag" data-t="luxury">Luxury Cars</span>
                            <h3><%= car.brand %> <%= car.model %></h3>
                            <span class="ec-luxury-price">HK$<%= Number(car.pricePerDay).toLocaleString("en-HK") %> <span data-t="perDay">/ day</span> →</span>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </div>
        </section>
        <% } %>

        <!-- ===============================
             Rental Process
        =============================== -->

        <!-- ===================================== -->
<!-- RENTAL PROCESS SECTION -->
<!-- ===================================== -->

    <section class="ec-section ec-process" id="steps">

        <div class="ec-container">

            <!-- Section Title -->
            <div class="ec-heading ec-process-heading">
                <div>
                    <h2 data-t="processTitle">
                        How Renting Works
                    </h2>

                    <p data-t="processSub">
                        Five simple steps from browsing to returning your car.
                    </p>
                </div>
            </div>


            <!-- Timeline -->
            <div class="ec-process-grid">


                <!-- STEP 1 -->
                <div class="ec-step ec-step-top">

                    <div class="ec-step-content">

                        <!-- Car Icon -->
                        <svg viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true">

                            <path d="M5 17h14l1-7-3-5H7L4 10l1 7Z"/>
                            <path d="M7 17v2M17 17v2M5 10h14"/>
                            <circle cx="8" cy="14" r="1"/>
                            <circle cx="16" cy="14" r="1"/>

                        </svg>

                        <h3>
                            <span>01</span>
                            <span data-t="step1">Choose a Car</span>
                        </h3>

                        <p data-t="step1d">
                            Browse models and pick the vehicle that suits your trip.
                        </p>

                    </div>

                    <div class="ec-step-dot"></div>

                </div>


                <!-- STEP 2 -->
                <div class="ec-step ec-step-bottom">

                    <div class="ec-step-dot"></div>

                    <div class="ec-step-content">

                        <!-- Calendar Icon -->
                        <svg viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true">

                            <rect x="3" y="5" width="18" height="16" rx="2"/>
                            <path d="M7 3v4M17 3v4M3 10h18"/>
                            <path d="M8 14h3M14 14h3M8 18h3"/>

                        </svg>

                        <h3>
                            <span>02</span>
                            <span data-t="step2">Select Dates</span>
                        </h3>

                        <p data-t="step2d">
                            Choose your pick-up and return dates.
                        </p>

                    </div>

                </div>


                <!-- STEP 3 -->
                <div class="ec-step ec-step-top">

                    <div class="ec-step-content">

                        <!-- Booking Icon -->
                        <svg viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true">

                            <path d="M6 3h12a2 2 0 0 1 2 2v15l-8-4-8 4V5a2 2 0 0 1 2-2Z"/>
                            <path d="M8 8h8M8 12h6"/>

                        </svg>

                        <h3>
                            <span>03</span>
                            <span data-t="step3">Log In & Book</span>
                        </h3>

                        <p data-t="step3d">
                            Create an account to submit a booking.
                        </p>

                    </div>

                    <div class="ec-step-dot"></div>

                </div>


                <!-- STEP 4 -->
                <div class="ec-step ec-step-bottom">

                    <div class="ec-step-dot"></div>

                    <div class="ec-step-content">

                        <!-- Key Icon -->
                        <svg viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true">

                            <circle cx="8" cy="8" r="5"/>
                            <path d="M11.5 11.5 21 21"/>
                            <path d="M16 16l2-2M18 18l2-2"/>

                        </svg>

                        <h3>
                            <span>04</span>
                            <span data-t="step4">Collect the Car</span>
                        </h3>

                        <p data-t="step4d">
                            Confirm the collection arrangements and inspect the vehicle.
                        </p>

                    </div>

                </div>


                <!-- STEP 5 -->
                <div class="ec-step ec-step-top">

                    <div class="ec-step-content">

                        <!-- Location Icon -->
                        <svg viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true">

                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                            <circle cx="12" cy="10" r="2.5"/>

                        </svg>

                        <h3>
                            <span>05</span>
                            <span data-t="step5">Return</span>
                        </h3>

                        <p data-t="step5d">
                            Return the car at your agreed time and location.
                        </p>

                    </div>

                    <div class="ec-step-dot"></div>

                </div>


            </div>

        </div>

    </section>

    </main>


    <!-- ===============================
         Footer
    =============================== -->

    <footer class="ec-footer">

        <div class="ec-container ec-footer-flex">

            <strong>
                RentDrive
            </strong>

            <small data-t="footer">
                © 2026 RentDrive —
                Car Rental Booking System
            </small>

            <small>

                <a
                    href="#fleet"
                    style="color:white"
                    data-t="footerFleet"
                >
                    Browse Cars
                </a>

            </small>

        </div>

    </footer>


