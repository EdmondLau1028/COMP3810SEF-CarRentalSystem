<%
const signedIn =
    typeof currentUser !== "undefined" && Boolean(currentUser);

const usingLiveCars = typeof featuredCars !== "undefined" && Array.isArray(featuredCars);
const visibleCars = usingLiveCars ? featuredCars : [];
const homeLuxuryCars = typeof luxuryCars !== "undefined" && Array.isArray(luxuryCars)
    ? luxuryCars : [];

const brands = [
    ...new Set(
        visibleCars.map(car =>
            String(car.brand || "").toUpperCase()
