<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>車輛管理 | RentDrive Admin</title>
  <style>
    :root {
      --sidebar: #28323b;
      --sidebar-border: #3a454f;
      --sidebar-text: #a8b9c6;
      --ice-blue: #32a7df;
      --ice-blue-dark: #167cb1;
      --ice-bg: #eff7fb;
      --text: #334550;
      --muted: #758692;
      --border: #dce5eb;
      --green: #35bb74;
      --orange: #f3a126;
      --edit: #36a8d9;
      --delete: #e65047;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, "Noto Sans TC", "Microsoft JhengHei", sans-serif; font-size: 14px; color: var(--text); background: var(--ice-bg); }
    a { color: inherit; text-decoration: none; }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    button:disabled { cursor: not-allowed; }
    .layout { min-height: 100vh; display: grid; grid-template-columns: 238px minmax(0, 1fr); }

    /* Compact charcoal sidebar, matching a conventional admin panel. */
    .sidebar { display: flex; flex-direction: column; background: var(--sidebar); color: var(--sidebar-text); }
    .sidebar-top { background: var(--ice-blue); color: #fff; height: 61px; display: flex; align-items: center; gap: 12px; padding: 0 20px; font-size: 15px; font-weight: 700; letter-spacing: .35px; }
    .de-brand { display: inline-flex; align-items: baseline; gap: 0; font-size: 21px; line-height: 1; font-weight: 900; letter-spacing: -1px; white-space: nowrap; }
    .de-brand .de-accent { color: #ff781f; font-style: italic; }
    .de-admin { font-size: 10px; letter-spacing: 1px; color: #e8f6fd; font-weight: 700; }
    .admin-identity { min-height: 67px; padding: 17px 18px; border-bottom: 1px solid var(--sidebar-border); display: flex; align-items: center; gap: 11px; }
    .identity-circle { width: 34px; height: 34px; border-radius: 50%; background: #42525f; display: grid; place-items: center; font-weight: bold; color: #fff; }
    .identity-name { color: #fff; font-size: 14px; font-weight: 600; }
    .identity-sub { display: block; font-size: 11px; color: #8ea3b0; margin-top: 4px; }
    .nav-heading { font-size: 10px; padding: 20px 19px 7px; color: #8397a4; font-weight: bold; letter-spacing: 1.4px; }
    .nav-link { display: flex; align-items: center; gap: 11px; padding: 12px 19px; color: var(--sidebar-text); font-size: 13px; min-height: 42px; }
    .nav-link:hover { background: #34434e; color: #fff; }
    .nav-link.active { background: #344854; border-left: 3px solid var(--ice-blue); padding-left: 16px; color: #fff; font-weight: bold; }
    .nav-icon { width: 16px; text-align: center; color: #a3bdcc; font-size: 15px; }
    .sidebar-bottom { margin-top: auto; border-top: 1px solid var(--sidebar-border); padding: 12px 0 20px; }
    .sidebar-bottom form { margin: 0; }
    .logout-side { width: 100%; text-align: left; background: transparent; border: 0; color: var(--sidebar-text); padding: 12px 19px; font-size: 13px; }
    .logout-side:hover { background: #34434e; color: #fff; }

    /* Flat workspace and a simple header. */
    .workspace { min-width: 0; }
    .topbar { height: 61px; display: flex; justify-content: space-between; align-items: center; padding: 0 27px; background: #fff; border-bottom: 1px solid var(--border); }
    .breadcrumbs { display: flex; gap: 10px; align-items: center; color: var(--muted); font-size: 12px; }
    .breadcrumbs a { color: var(--ice-blue-dark); }
    .breadcrumbs strong { font-weight: 600; color: var(--text); }
    .top-user { display: flex; gap: 9px; align-items: center; font-size: 12px; color: var(--muted); }
    .small-avatar { border-radius: 50%; background: #d8eefb; width: 29px; height: 29px; color: #237faa; font-weight: 700; display: grid; place-items: center; }
    .content { padding: 29px 28px 40px; max-width: 1600px; margin: 0 auto; }
    .page-title { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 13px; margin: 2px 0 25px; }
    .page-title h1 { font-size: 21px; font-weight: 700; margin: 0; color: #364a58; }
    .page-title h1 .db-icon { color: var(--ice-blue-dark); font-size: 23px; padding-right: 9px; font-weight: normal; }
    .create-btn { background: var(--green); color: #fff; font-size: 12px; font-weight: 700; border: 0; border-radius: 3px; padding: 10px 15px; }
    .create-btn:disabled { opacity: .62; }

    /* Compact grid table for vehicle records. */
    .panel { background: #fff; border: 1px solid var(--border); }
    .table-tools { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding: 15px 16px; background: #fff; }
    .table-title { font-size: 15px; font-weight: 700; }
    .result-count { font-size: 12px; color: var(--muted); font-weight: normal; margin-left: 8px; }
    .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .text-input, .select-input { background: #fff; border: 1px solid #cbd8e1; min-height: 34px; border-radius: 2px; outline-color: #7cc6ed; padding: 6px 10px; color: var(--text); }
    .text-input { width: 210px; }
    .select-input { width: 120px; }
    .search-btn, .clear-btn { border: 1px solid #2a8cc1; border-radius: 2px; min-height: 34px; padding: 6px 13px; font-size: 12px; }
    .search-btn { background: var(--ice-blue-dark); color: #fff; }
    .clear-btn { display: inline-flex; align-items: center; background: #fff; color: var(--ice-blue-dark); }
    .table-scroller { overflow-x: auto; }
    table { width: 100%; min-width: 900px; border-collapse: collapse; text-align: left; }
    thead { background: #f1f5f8; }
    th { border-bottom: 1px solid #cbd9e3; padding: 12px 13px; font-size: 12px; font-weight: 700; color: #4c6271; white-space: nowrap; }
    td { border-bottom: 1px solid #e5ecf0; padding: 10px 13px; font-size: 12px; color: #4b5c65; }
    tbody tr:nth-child(even) { background: #f9fbfc; }
    tbody tr:hover { background: #edf7fc; }
    tbody tr:last-child td { border-bottom: 0; }
    .vehicle-cell { display: flex; align-items: center; gap: 10px; min-width: 175px; }
    .vehicle-img { width: 61px; height: 42px; object-fit: cover; border: 1px solid #dee8ee; background: #eef3f6; flex-shrink: 0; }
    .vehicle-name { display: block; color: #245d83; font-weight: 700; font-size: 12px; }
    .vehicle-id { font-size: 10px; color: #97a5ae; margin-top: 4px; }
    .price { color: #2d4453; font-weight: 700; white-space: nowrap; }
    .status { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: #168b5b; font-weight: 700; }
    .status::before { content: ""; width: 6px; height: 6px; background: #22ad68; border-radius: 50%; }
    .status.off { color: #929da5; }
    .status.off::before { background: #9eabb3; }
    .actions { display: flex; gap: 5px; white-space: nowrap; }
    .actions form { display: inline; margin: 0; }
    .action { padding: 7px 10px; color: #fff; font-size: 11px; border-radius: 2px; border: 0; display: inline-block; line-height: 1; }
    .action.view { background: var(--orange); }
    .action.edit { background: var(--edit); }
    .action.delete { background: var(--delete); }
    .action:disabled { opacity: .55; }
    .empty { padding: 35px; text-align: center; color: var(--muted); }
    .table-footer { border-top: 1px solid var(--border); background: #fff; padding: 12px 16px; font-size: 12px; color: var(--muted); }
    .notice { border: 1px solid #b4d9c7; color: #246747; background: #eaf8f0; padding: 12px 15px; margin: 0 0 16px; font-size: 13px; }
    .action:hover, .create-btn:hover { filter: brightness(.94); }
    @media (max-width: 840px) {
      .layout { grid-template-columns: 180px minmax(0, 1fr); }
      .sidebar-top { padding: 0 12px; font-size: 12px; }
      .content { padding: 20px 13px; }
      .topbar { padding: 0 12px; }
      .text-input { width: 160px; }
    }
    @media (max-width: 610px) {
      .layout { display: block; }
      .sidebar { min-height: auto; }
      .sidebar-top { height: 46px; }
      .admin-identity, .sidebar nav, .sidebar-bottom { display: none; }
      .content { padding: 15px 10px; }
      .table-tools { align-items: flex-start; }
      .filters { width: 100%; }
      .text-input { flex: 1; min-width: 140px; }
    }
  </style>
</head>
<body>
<%
  const rows = Array.isArray(cars) ? cars : [];
  const searchValue = typeof q === "string" ? q : "";
  const chosenCategory = typeof category === "string" ? category : "";
  const overallCount = Number.isFinite(Number(totalCars)) ? Number(totalCars) : rows.length;
  const categoryLabel = { private: "私家車", family: "家庭車", electric: "電動車", luxury: "豪華車" };
  const adminLabel = typeof currentUser === "string" && currentUser ? currentUser : "Admin";
%>
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-top"><a class="de-brand" href="/admin" aria-label="RentDrive Admin"><span>Rent</span><span class="de-accent">Drive</span></a><small class="de-admin">ADMIN</small></div>
    <div class="admin-identity">
      <span class="identity-circle"><%= adminLabel.slice(0, 1).toUpperCase() %></span>
      <div><span class="identity-name"><%= adminLabel %></span><small class="identity-sub">Administrator</small></div>
    </div>
    <nav aria-label="後台選單">
      <div class="nav-heading">MANAGEMENT</div>
      <a class="nav-link active" href="/admin/cars" aria-current="page"><span class="nav-icon">▤</span>車輛管理</a>
      <a class="nav-link" href="/admin/cars/new">
        <span class="nav-icon">＋</span>
        新增車輛
      </a>
      <a class="nav-link" href="/admin/bookings"><span class="nav-icon">▣</span>預訂管理</a>
      <a class="nav-link" href="/admin/users"><span class="nav-icon">♙</span>會員管理</a>
      <div class="nav-heading">OTHER</div>
      <a class="nav-link" href="/admin"><span class="nav-icon">↩</span>返回後台</a>
    </nav>
    <div class="sidebar-bottom">
      <form action="/logout" method="POST"><button class="logout-side" type="submit">⇥　登出</button></form>
    </div>
  </aside>

  <div class="workspace">
    <header class="topbar">
        <div class="breadcrumbs"><a href="/admin">Admin</a><span>›</span><strong>車輛資料庫</strong></div>
      <div class="top-user"><span><%= adminLabel %></span><span class="small-avatar"><%= adminLabel.slice(0, 1).toUpperCase() %></span></div>
    </header>

    <main class="content">
      <div class="page-title">
        <h1><span class="db-icon">▤</span>車輛資料庫</h1>
        <a class="create-btn" href="/admin/cars/new">＋ 新增車輛</a>
      </div>

      <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>

      <section class="panel" aria-label="車輛資料表">
        <div class="table-tools">
          <div class="table-title">車輛清單 <span class="result-count"><%= rows.length %> / <%= overallCount %> 筆資料</span></div>
          <form class="filters" method="GET" action="/admin/cars" role="search">
            <input class="text-input" name="q" maxlength="80" value="<%= searchValue %>" placeholder="搜尋品牌或車型" aria-label="搜尋品牌或車型">
            <select class="select-input" name="category" aria-label="篩選類別">
              <option value="" <%= chosenCategory === "" ? "selected" : "" %>>所有類別</option>
              <option value="private" <%= chosenCategory === "private" ? "selected" : "" %>>私家車</option>
              <option value="family" <%= chosenCategory === "family" ? "selected" : "" %>>家庭車</option>
              <option value="electric" <%= chosenCategory === "electric" ? "selected" : "" %>>電動車</option>
              <option value="luxury" <%= chosenCategory === "luxury" ? "selected" : "" %>>豪華車</option>
            </select>
            <button class="search-btn" type="submit">搜尋</button>
            <a class="clear-btn" href="/admin/cars">重設</a>
          </form>
        </div>

        <div class="table-scroller">
          <table>
            <thead>
              <tr><th>車輛</th><th>類別</th><th>年份</th><th>座位</th><th>每日租金</th><th>狀態</th><th>操作</th></tr>
            </thead>
            <tbody>
              <% rows.forEach(car => { %>
                <tr>
                  <td>
                    <div class="vehicle-cell">
                      <img class="vehicle-img" src="<%= car.image || '/images/car01.jpg' %>" alt="<%= car.brand %> <%= car.model %>" loading="lazy" onerror="this.onerror=null;this.src='/images/car01.jpg'">
                      <div><span class="vehicle-name"><%= car.brand %> <%= car.model %></span><div class="vehicle-id"><%= String(car._id).slice(-8) %></div></div>
                    </div>
                  </td>
                  <td><%= categoryLabel[car.category] || car.category || "未分類" %></td>
                  <td><%= car.year || "—" %></td>
                  <td><%= car.seats || "—" %></td>
                  <td class="price">HK$<%= Number(car.pricePerDay || 0).toLocaleString('en-HK') %></td>
                  <td><span class="status <%= car.available === true ? '' : 'off' %>"><%= car.available === true ? "上架中" : "已下架" %></span></td>
                  <td><div class="actions">
                    <a class="action view" href="/cars/<%= String(car._id) %>" target="_blank" rel="noopener">View</a>
                    <a class="action edit" href="/admin/cars/<%= String(car._id) %>/edit">Edit</a>
                    <form method="POST" action="/admin/cars/<%= String(car._id) %>/delete" onsubmit="return confirm('確定永久刪除這輛車嗎？此操作無法還原。\n如果已有預訂紀錄，系統會阻止刪除。');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="action delete" type="submit">Delete</button>
                    </form>
                  </div></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <% if (rows.length === 0) { %><div class="empty">找不到符合條件的車輛，請更改搜尋條件。</div><% } %>
        </div>
        <div class="table-footer">顯示 <%= rows.length %> 筆資料，資料庫共有 <%= overallCount %> 輛車。</div>
      </section>
    </main>
  </div>
</div>
</body>
</html>
