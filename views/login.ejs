<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Log in | DriveEase</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="navbar">
        <a class="brand" href="/">DriveEase</a>
        <nav aria-label="Main navigation"><a href="/">Home</a><a href="/cars">Browse cars</a><a href="/register">Create account</a></nav>
    </header>
    <main class="auth-wrap">
        <section class="auth-card">
            <p class="eyebrow">WELCOME BACK</p>
            <h1>Log in to DriveEase</h1>
            <p class="muted">Manage your bookings and get back on the road.</p>
            <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
            <% if (typeof error !== 'undefined' && error) { %><p class="alert" role="alert"><%= error %></p><% } %>
            <form action="/login" method="post" class="form-stack">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required>
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
                <button class="button button-full" type="submit">Log in</button>
            </form>
            <p class="auth-switch">Don't have an account? <a class="text-link" href="/register">Create one</a></p>
        </section>
    </main>
    <footer class="footer"><p>DriveEase <span aria-hidden="true">·</span> A smoother way to get there.</p></footer>
</body>
</html>
